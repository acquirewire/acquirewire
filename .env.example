# Anthropic API key used by scripts/generate.mjs (set as a GitHub Actions secret in CI)
ANTHROPIC_API_KEY=sk-ant-...

# Model used for article generation
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional: ntfy topic to ping when a new draft PR is opened (matches your ticket-bot setup)
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
