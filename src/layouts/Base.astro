---
import '../styles/global.css';
import { getCollection } from 'astro:content';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  active?: string;
}

const {
  title = 'AcquireWire — M&A & Markets Intelligence',
  description = 'Sharp, daily intelligence on the deals, capital flows, and market moves that matter. One email every weekday morning.',
  image = 'https://images.unsplash.com/photo-1611974789855-9c2a0a7236a3?w=1200&q=80',
  type = 'website',
  publishedTime,
  active = '',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const year = new Date().getFullYear();

// Latest headlines for the ticker
const ticker = (await getCollection('articles', ({ data }) => (import.meta.env.PROD ? !data.draft : true)))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 8)
  .map((a) => ({ title: a.data.title, id: a.id }));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="AcquireWire" href="/rss.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="AcquireWire" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:url" content={canonical} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- Theme: dark-first. Only switch to light if explicitly chosen. -->
    <script is:inline>
      (function () {
        try {
          if (localStorage.getItem('aw-theme') === 'light') {
            document.documentElement.classList.add('light');
          }
        } catch (e) {}
      })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,400;1,9..144,600&family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="masthead">
      <div class="wrap masthead-inner">
        <a class="brand" href="/" aria-label="AcquireWire home">
          <span class="brand-mark">A</span>
          <span class="brand-name">Acquire<b>Wire</b></span>
        </a>

        <nav class="nav" id="nav">
          <a href="/" class={active === 'feed' ? 'active' : ''}>The Wire</a>
          <a href="/markets" class={active === 'markets' ? 'active' : ''}>Markets</a>
          <a href="/deals" class={active === 'deals' ? 'active' : ''}>Deals</a>
          <a href="/newsletter" class={active === 'newsletter' ? 'active' : ''}>Newsletter</a>
          <a href="/about" class={active === 'about' ? 'active' : ''}>About</a>
        </nav>

        <div class="nav-right">
          <a class="theme-btn" href="/search" aria-label="Search">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          </a>
          <button class="theme-btn" id="themeBtn" aria-label="Toggle theme">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
          </button>
          <a class="btn" href="/newsletter">Subscribe</a>
          <button class="menu-toggle" id="menuToggle" aria-label="Menu">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
          </button>
        </div>
      </div>
    </header>

    <!-- Live market price tape (populated client-side from /api/quotes) -->
    <div class="tape" id="tape" hidden aria-label="Live market prices">
      <div class="tape-label">Markets</div>
      <div class="tape-row" id="tapeRow"></div>
    </div>

    {ticker.length > 0 && (
      <div class="ticker" aria-hidden="true">
        <div class="ticker-label"><span class="pulse"></span>Live</div>
        <div class="ticker-track">
          {[...ticker, ...ticker].map((t) => (
            <a class="ticker-item" href={`/articles/${t.id}/`}>
              <span class="tick-dot"></span>
              <b>{t.title}</b>
            </a>
          ))}
        </div>
      </div>
    )}

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap">
        <div class="footer-grid">
          <div>
            <span class="brand-name">Acquire<b>Wire</b></span>
            <p class="desc">
              Independent intelligence on M&A, private capital, and the market moves that move
              everything else. Written for people who read the footnotes.
            </p>
          </div>
          <div>
            <h4>Sections</h4>
            <ul>
              <li><a href="/">The Wire</a></li>
              <li><a href="/newsletter">Daily Wire</a></li>
              <li><a href="/about">About</a></li>
              <li><a href="/rss.xml">RSS</a></li>
            </ul>
          </div>
          <div>
            <h4>Coverage</h4>
            <ul>
              <li><a href="/">Deals</a></li>
              <li><a href="/">Private Equity</a></li>
              <li><a href="/">Markets</a></li>
              <li><a href="/">Regulation</a></li>
            </ul>
          </div>
        </div>
        <div class="footer-bottom">
          <p>© {year} AcquireWire</p>
          <p>London</p>
        </div>
        <p class="disclaimer">
          AcquireWire is a financial news and analysis publication for informational purposes only.
          Nothing here is investment advice, a recommendation, or an offer to buy or sell any
          security. Figures are sourced from public reporting and may contain errors. Always do your
          own research.
        </p>
      </div>
    </footer>

    <script is:inline>
      (function () {
        var btn = document.getElementById('themeBtn');
        if (btn) {
          btn.addEventListener('click', function () {
            var light = document.documentElement.classList.toggle('light');
            try { localStorage.setItem('aw-theme', light ? 'light' : 'dark'); } catch (e) {}
          });
        }
        var mt = document.getElementById('menuToggle');
        var nav = document.getElementById('nav');
        if (mt && nav) { mt.addEventListener('click', function () { nav.classList.toggle('open'); }); }
      })();
    </script>

    <!-- Live market price tape -->
    <script is:inline>
      (function () {
        var tape = document.getElementById('tape');
        var row = document.getElementById('tapeRow');
        if (!tape || !row) return;

        function fmtPrice(p) {
          if (p >= 1000) return p.toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
          if (p >= 1) return p.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
          return p.toLocaleString('en-US', { minimumFractionDigits: 4, maximumFractionDigits: 4 });
        }

        function render(quotes) {
          if (!quotes || !quotes.length) { tape.hidden = true; return; }
          var html = '';
          for (var i = 0; i < quotes.length; i++) {
            var q = quotes[i];
            var up = q.changePct >= 0;
            var arrow = up ? '▲' : '▼';
            var cls = up ? 'up' : 'down';
            html +=
              '<span class="tape-item">' +
              '<span class="tape-sym">' + q.label + '</span>' +
              '<span class="tape-px">' + fmtPrice(q.price) + '</span>' +
              '<span class="tape-chg ' + cls + '">' + arrow + ' ' + Math.abs(q.changePct).toFixed(2) + '%</span>' +
              '</span>';
          }
          row.innerHTML = html;
          tape.hidden = false;
        }

        function load() {
          fetch('/api/quotes', { cache: 'no-store' })
            .then(function (r) { return r.ok ? r.json() : null; })
            .then(function (d) { if (d) render(d.quotes); })
            .catch(function () { /* leave hidden on failure */ });
        }

        load();
        setInterval(load, 60000);
      })();
    </script>
  </body>
</html>
